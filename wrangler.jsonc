{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "campos-ancla-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  // Secrets (no commits):
  //   ENCRYPTION_KEY — AES key material for Cluster Mongo URI in D1 (Cluster → Conexión)
  //   MONGODB_URI    — ops-only; not a product Ajustes / global fallback
  //   MONGODB_DB     — optional default software_reservas
  //   OPENAI_API_KEY — Redactor / skill generar-definicion (optional; mock if absent)
  //   OPENAI_MODEL   — optional (default gpt-4o-mini)
  //   CORRIDA_STALE_MS — optional; ms sin avance en en_curso → error (default 10800000 = 3h)
  //   npx wrangler secret put ENCRYPTION_KEY
  //   npx wrangler secret put MONGODB_URI
  //   npx wrangler secret put OPENAI_API_KEY
  "vars": {
    "PUBLIC_UI_ORIGIN": "https://campos-ancla.web-legal-es.workers.dev",
    "CORS_ORIGINS": "https://frescofresco.github.io"
  },
  "rules": [
    { "type": "Text", "globs": ["**/documentacion/api.md"], "fallthrough": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campos-ancla-db",
      "database_id": "42cb5187-a922-4e40-8227-0e72c1002f15",
      "preview_database_id": "local-campos-ancla-db",
      "migrations_dir": "migrations"
    }
  ],
  // Motor de disparadores horario (Atlantic/Canary se aplica en código al matchear cron).
  "triggers": {
    "crons": ["* * * * *"]
  }
}
