{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arquitectura-reservas-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "PUBLIC_UI_ORIGIN": "https://frescofresco.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arquitectura-reservas",
      // Placeholder until `wrangler d1 create arquitectura-reservas` (replace with real UUID).
      "database_id": "00000000-0000-4000-8000-000000000001",
      "preview_database_id": "local-arquitectura-reservas",
      "migrations_dir": "migrations"
    }
  ]
}
