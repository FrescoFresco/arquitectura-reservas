{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "campos-ancla-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "PUBLIC_UI_ORIGIN": "https://frescofresco.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campos-ancla-db",
      "database_id": "42cb5187-a922-4e40-8227-0e72c1002f15",
      "preview_database_id": "local-campos-ancla-db",
      "migrations_dir": "migrations"
    }
  ]
}
