{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "campos-ancla-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  // Secrets (no commits): MONGODB_URI (required for Atlas writes), optional MONGODB_DB.
  //   npx wrangler secret put MONGODB_URI
  //   npx wrangler secret put MONGODB_DB   # default arquitectura_reservas
  "vars": {
    "PUBLIC_UI_ORIGIN": "https://campos-ancla.web-legal-es.workers.dev",
    "CORS_ORIGINS": "https://frescofresco.github.io"
  },
  "rules": [
    { "type": "Text", "globs": ["**/documentacion/api.md"], "fallthrough": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campos-ancla-db",
      "database_id": "42cb5187-a922-4e40-8227-0e72c1002f15",
      "preview_database_id": "local-campos-ancla-db",
      "migrations_dir": "migrations"
    }
  ]
}
